# Copy this file to ".env" and fill in the values. Never commit ".env".

# REQUIRED: get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

POSTGRES_PASSWORD=your_password

# Optional: name of the Qdrant collection (default shown)
QDRANT_COLLECTION_NAME=proxigen_knowledge

# ---------------------------------------------------------------------------
# MANUAL SETUP ONLY (running with "uv run", NOT with Docker Compose).
# Docker Compose sets these two for you automatically, so leave them commented
# out if you use Docker. For the manual setup, uncomment them and use the same
# password you gave to the PostgreSQL container/service.
# ---------------------------------------------------------------------------
# CHECKPOINT_DB_URL=postgresql://postgres:your_password@localhost:5432/proxigen
# QDRANT_URL=http://localhost:6333

# Optional: developer tracing with LangSmith (leave these out to disable)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_api_key
# LANGSMITH_PROJECT=proxigen-rag
